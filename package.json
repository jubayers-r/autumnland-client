{
  "name": "autumnland-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:quick": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "validate:full": "bun run test:e2e && bun run build",
    "validate": "bun run validate:quick && bun run validate:full",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
