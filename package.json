    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6.0.0"
  },
  "packageManager": "bun@1.3.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
